# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file.

# Your Figma personal access token
# Create one at: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# Your Anthropic API key
# Create one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Port the local server listens on (optional, defaults to 3000)
PORT=3000

# --- Optional: design system consistency checks ---
# Point these at your design system Figma file, and list every reference
# page you want Claude to compare against (Components, Typography, Colors,
# etc.) as "Label=nodeId" pairs, comma-separated. Each page is rendered as a
# labeled reference image and sent to Claude alongside every frame being
# reviewed, so it can check whether the frame reuses your real components
# and styles correctly.
#
# Example:
# DESIGN_SYSTEM_FILE_KEY=abc123XYZ
# DESIGN_SYSTEM_PAGES=Components=1:23,Typography=4:56,Colors=7:89
DESIGN_SYSTEM_FILE_KEY=
DESIGN_SYSTEM_PAGES=
